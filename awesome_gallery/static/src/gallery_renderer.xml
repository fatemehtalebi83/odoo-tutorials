<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="awesome_gallery.GalleryRenderer">

	    <div class="d-flex flex-wrap gap-3">
        <t
            t-foreach="props.model.state.records"
            t-as="record"
            t-key="record.id + '-' + record.write_date">

	        <GalleryItem
                record="record"
                imageField="props.imageField"
                tooltipTemplate="props.tooltipTemplate"
                resModel="props.model.resModel"
                openRecord="openRecord"
                onUploaded="onUploaded"
            />

        </t>
	    </div>

    </t>

	<t t-name="awesome_gallery.GalleryItem">
        <div class="m-2 position-relative" style="width: 150px;">
            <t t-if="props.record[props.imageField]">

                <img
		            t-ref="tooltip"
                    t-att-src="getImageUrl()"
                    width="150"
                    height="150"
                    style="object-fit: cover;"
                    t-on-click="() => props.openRecord(props.record)"
                />
            </t>

            <t t-else="">
                <div style="width:150px; height:150px;
                     border:1px solid #ccc;">
                </div>
            </t>

            <FileUploader
                onUploaded="(file) => props.onUploaded(props.record, file)"
             >
              <t t-set-slot="toggler">
                  <button
                      type="button"
                      class="btn btn-sm btn-primary position-absolute"
                      style="right: 5px; bottom: 5px;">
                    Upload Image
                  </button>
              </t>
            </FileUploader>

        </div>
    </t>

</templates>