<?xml version="1.0" encoding="UTF-8" ?>
<template xml:space="preserve">

	<t t-name="awesome_kanban.CustomerList">
		<div>

			<div class="p-3 border-bottom">
				Customers
				<p>
					<input type="checkbox" t-model="state.displayActiveCustomers"/>
				    <label class="m-2">
					    Active Customers
				    </label>
				</p>
				<hr/>
				<p>
					<input
					    type="text"
					     class="form-control mb-3"
					     placeholder="Search"
					     t-model="state.searchString"/>
				</p>
			</div>

			<t t-foreach="displayedCustomer" t-as="customer" t-key="customer.id">
				<div class="p-3 border-bottom"
				     t-on-click="() => props.selectCustomer(customer)">
					<t t-esc="customer.name"/>
				</div>
			</t>

		</div>
	</t>
</template>