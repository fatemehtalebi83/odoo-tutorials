<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.counter">

	    <div class="border rounded p-3 d-flex align-items-center gap-3 fw-bold">
	        <span>
		        Counter:
		        <t t-esc="state.value"/>
	        </span>

	        <button
			    class="btn btn-primary"
			    style="background-color: #71639e; border-color: #71639e; color: white;"
			    t-on-click="increment">
		        Increment
	        </button>
	    </div>
    </t>
</templates>
