<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.TodoList">
        <div class="card d-inline-block p-3">
            <input
		        t-ref="todoInput"
                type="text"
                class="form-control mb-3"
                placeholder="Enter a new task"
                t-on-keyup="addTodo"/>
	        <TodoItem
                t-foreach="todos"
                t-as="todo"
                t-key="todo.id"
                todo="todo"/>
        </div>
    </t>
</templates>