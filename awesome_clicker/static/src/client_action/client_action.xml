<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

	<t t-name="awesome_clicker.client_action">

		<div class="p-3">
			<h2 class="mb-4">Clicker Game</h2>

			<div class="d-flex align-items-center gap-3 mb-4">
			    <p>
				    Clicks:
				    <ClickValue value="clicker.clicks"/>
			    </p>

			    <button class="btn btn-primary o_clicker_increment" t-on-click="increment">
				    Increment
			    </button>
			</div>

			<div class="mt-3">
			    <Notebook pages="pages">

				<t t-set-slot="clicks">
					<div class="pt-3">
			            <t t-if="clicker.level gte 1">

                        <div>
                            ClickBots:
                            <ClickValue value="clicker.clickBots"/>
                        </div>

                        <button
		                    class="btn btn-primary"
                            t-on-click="buyClickBot"
                            t-att-disabled="clicker.clicks lt 1000">
                              Buy ClickBot (1000 clicks)
                        </button>
                    </t>

					    <t t-if="clicker.level gte 2">

                        <div>
                            BigBots:
                            <ClickValue value="clicker.bigBots"/>
                        </div>

                        <button
		                    class="btn btn-primary"
                            t-on-click="buyBigBot"
                            t-att-disabled="clicker.clicks lt 5000">
                               Buy ClickBot (5000 clicks)
                        </button>
                    </t>

			            <t t-if="clicker.level gte 3">

                        <div>
                            Power:
                            <ClickValue value="clicker.power"/>
                        </div>

                        <button
		                    class="btn btn-primary"
                            t-on-click="buyPower"
                            t-att-disabled="clicker.clicks lt 50000">
                              Increase Power (50000 clicks)
                        </button>
                    </t>
					</div>
				</t>

                <t t-set-slot="trees">
	                <div class="pt-3">
	                    <t t-if="clicker.level gte 4">

                        <hr/>
					    <h4>Trees</h4>

					    <div>
                            Pear Trees:
                            <t t-esc="clicker.pearTrees"/>
                        </div>

					    <div>
                            Cherry Trees:
                            <t t-esc="clicker.cherryTrees"/>
                        </div>

		                <div>
                            Total Trees:
                            <t t-esc="clicker.totalTrees"/>
                        </div>

					    <br/>

					    <h4>Fruits</h4>

					    <div>
                            Pears:
                            <t t-esc="clicker.pears"/>
                        </div>

					    <div>
                            Cherries:
                            <t t-esc="clicker.cherries"/>
                        </div>

					    <div>
                            Total Fruits:
                            <t t-esc="clicker.totalFruits"/>
                        </div>

					    <br/>

				        <button
				            class="btn btn-primary me-2"
				            t-on-click="buyPearTree"
				            t-att-disabled="clicker.clicks lt 1000000">
                              Buy Pear Tree (1000000 clicks)
                        </button>

				        <button
				            class="btn btn-primary"
				            t-on-click="buyCherryTree"
				            t-att-disabled="clicker.clicks lt 1000000">
                              Buy Cherry Tree (1000000 clicks)
                        </button>
				    </t>
	                </div>
                </t>

            </Notebook>
			</div>

		</div>
	</t>

</templates>