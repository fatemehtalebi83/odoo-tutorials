<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
	    <Layout className="'o_dashboard h-100'" display="{controlPanel: {} }">

		    <t t-set-slot="control-panel-always-buttons">

                <button
                    class="btn btn-primary"
                    t-on-click="openCustomers"
                >
                    Customers
                </button>

                <button
                    class="btn btn-primary ms-2"
                    t-on-click="openLeads"
                >
                    Leads
                </button>

            </t>

		    <div class="d-flex flex-wrap gap-3 p-3">

			    <DashboardItem size="1.5">
                    <div class="dashboard-card">
                        <div class="dashboard-title">
                            Average amount of t-shirt by order this month
                        </div>
                        <div class="dashboard-value">
                            <t t-esc="statistics.average_quantity"/>
                        </div>
                    </div>
                </DashboardItem>

               <DashboardItem size="2">
                   <div class="dashboard-card">
                       <div class="dashboard-title">
                           Average time for an order to go from 'new' to 'sent' or 'cancelled'
                       </div>
                       <div class="dashboard-value">
                           <t t-esc="statistics.average_time"/>
                       </div>
                   </div>
               </DashboardItem>

               <DashboardItem size="1">
                   <div class="dashboard-card">
                       <div class="dashboard-title">
                           Number of new orders this month
                       </div>
	                   <div class="dashboard-value">
                           <t t-esc="statistics.nb_new_orders"/>
                       </div>
                   </div>
               </DashboardItem>

               <DashboardItem size="1.5">
                   <div class="dashboard-card">
                       <div class="dashboard-title">
                           Number of cancelled orders this month
                       </div>
                       <div class="dashboard-value">
                           <t t-esc="statistics.nb_cancelled_orders"/>
                       </div>
                   </div>
               </DashboardItem>

               <DashboardItem size="1.5">
                   <div class="dashboard-card">
                       <div class="dashboard-title">
                           Total amount of new orders this month
                       </div>
                       <div class="dashboard-value">
                           <t t-esc="statistics.total_amount"/>
                       </div>
                   </div>
               </DashboardItem>

		    </div>
	    </Layout>
    </t>

</templates>
